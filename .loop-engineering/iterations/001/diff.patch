+        `| ${item.prompt} | ${item.expected.join(", ") || "none"} | ${[...selected].join(", ") || "none"} | FAIL (API/runtime/header; no fabricated answer) |`,
+      );
+    }
+  }
+  process.exitCode = failed ? 1 : 0;
 }
